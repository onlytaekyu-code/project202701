<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.security</groupId>
		<artifactId>project202701</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>project202701-web</artifactId>
	<!-- JSP 사용으로 WAR 패키징 -->
	<packaging>war</packaging>
	<!-- 웹은 원격 대상·수집기와 직접 통신하지 않는다. Flyway 및 원격 접속 라이브러리 의존 금지. -->

	<dependencies>
		<dependency>
			<groupId>com.security</groupId>
			<artifactId>project202701-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.security</groupId>
			<artifactId>project202701-persistence</artifactId>
		</dependency>

		<!-- 웹 (Spring MVC, 내장 Tomcat 11) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- JSP 렌더링 -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-jasper</artifactId>
		</dependency>

		<!-- Jakarta JSTL -->
		<dependency>
			<groupId>jakarta.servlet.jsp.jstl</groupId>
			<artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish.web</groupId>
			<artifactId>jakarta.servlet.jsp.jstl</artifactId>
		</dependency>

		<!-- 테스트 (JUnit, @SpringBootTest) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
