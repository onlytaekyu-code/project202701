<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.10</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.security</groupId>
	<artifactId>project202701</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<!-- 집계(aggregator) 및 공통 부모 POM. 실행 단위는 하위 모듈이다. -->
	<packaging>pom</packaging>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
		<module>common</module>
		<module>persistence</module>
		<module>db-migration</module>
		<module>web</module>
		<module>collector</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<!-- Boot BOM이 관리하지 않는 라이브러리 버전 -->
		<mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- 내부 모듈 -->
			<dependency>
				<groupId>com.security</groupId>
				<artifactId>project202701-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.security</groupId>
				<artifactId>project202701-persistence</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- MyBatis (spring-boot-starter-jdbc, HikariCP 포함) -->
			<dependency>
				<groupId>org.mybatis.spring.boot</groupId>
				<artifactId>mybatis-spring-boot-starter</artifactId>
				<version>${mybatis-spring-boot.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- 재현 가능한 빌드를 위한 Java/Maven 버전 및 동적 버전 금지 (모든 하위 모듈에 상속) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-build-rules</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[25,26)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<banDynamicVersions>
									<!-- 같은 리액터의 내부 모듈은 프로젝트 버전(0.0.1-SNAPSHOT)을 공유하므로 제외한다(D-010).
									     외부 의존성의 SNAPSHOT, 범위, LATEST, RELEASE는 계속 금지한다. -->
									<ignores>
										<ignore>com.security:project202701-*</ignore>
									</ignores>
								</banDynamicVersions>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
